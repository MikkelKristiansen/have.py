{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "bed.yaml",
  "description": "Have.py bedeplan — ét område med bede, zoner og afgrøder for et givent år",
  "type": "object",
  "required": [
    "bede"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "description": "Metadata om området",
      "additionalProperties": false,
      "properties": {
        "år": {
          "type": "integer",
          "description": "Havesæsonens år, fx 2026"
        },
        "titel": {
          "type": "string",
          "description": "Sidetitel, fx 'Drivhuset'"
        },
        "html_navn": {
          "type": "string",
          "description": "URL-slug og filnavn uden .html, fx 'drivhus'"
        },
        "ikon": {
          "type": "string",
          "description": "Emoji-ikon til navigation"
        },
        "ikon_billede": {
          "type": "string",
          "description": "Sti til headerbillede, fx 'fotos/drivhus.jpg'"
        },
        "undertitel": {
          "type": "string"
        },
        "beskrivelse": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "bede": {
      "type": "array",
      "description": "Liste af bede i dette område",
      "items": {
        "$ref": "#/$defs/Bed"
      }
    },
    "kalender_planter": {
      "type": "array",
      "description": "Plante-ID'er der vises i almanakkens kalender for dette område",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "Bed": {
      "type": "object",
      "required": [
        "id",
        "navn",
        "bredde_cm",
        "dybde_cm"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unikt ID for bedet inden for filen, fx 'bed-1'",
          "pattern": "^[a-z0-9-]+$"
        },
        "navn": {
          "type": "string",
          "description": "Vist navn, fx 'Det store drivhus — nord'"
        },
        "bredde_cm": {
          "type": "integer",
          "minimum": 1,
          "description": "Bedebredde i cm"
        },
        "dybde_cm": {
          "type": "integer",
          "minimum": 1,
          "description": "Bedets dybde (længde) i cm"
        },
        "farve": {
          "type": [
            "string",
            "null"
          ],
          "description": "Baggrundsfarve i beddiagrammet, hex-kode fx '#d4edda'",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "noter": {
          "type": [
            "string",
            "null"
          ],
          "description": "Fri tekst om bedet — vises under beddiagrammet"
        },
        "zoner": {
          "type": "array",
          "description": "Zoner/kolonner i bedet — bredder skal summere til ≤ 1.0",
          "items": {
            "$ref": "#/$defs/Zone"
          }
        }
      }
    },
    "Zone": {
      "type": "object",
      "required": [
        "navn",
        "bredde"
      ],
      "additionalProperties": false,
      "properties": {
        "navn": {
          "type": "string",
          "description": "Zonens navn, fx 'Tomater' eller 'Kartofler → Majroer'"
        },
        "bredde": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Zonebredde som andel af bedet (0–1). Alle zoner bør summere til 1.0"
        },
        "plante_id": {
          "type": "string",
          "description": "Direkte reference til en plante i planter.yaml — brug dette eller afgrøder[], ikke begge",
          "enum": [
            "allium-sativum",
            "brombaer",
            "busktomat",
            "california-wonder",
            "cayenne",
            "citronmelisse",
            "diamant",
            "dild",
            "estragon",
            "filippa",
            "genovese",
            "goldball",
            "groen-tapas",
            "groene-aerter",
            "gulloeg",
            "habenero",
            "half-tall",
            "hindbaer",
            "ingrid-marie",
            "jordbaer",
            "koervel",
            "koriander",
            "marketmore",
            "matador",
            "maxi",
            "money-maker",
            "mynte",
            "nantes",
            "nero-di-toscana",
            "ola-escalladora",
            "oregano",
            "paere",
            "pak-choi",
            "persille",
            "pluksalat",
            "purloeg",
            "quadro",
            "rabarber",
            "radise",
            "ribs",
            "roedloeg",
            "rosmarin",
            "rucola",
            "salat",
            "salvie",
            "sava",
            "scarlet",
            "snitloeg",
            "solbaer",
            "solist",
            "solstik",
            "sommersar",
            "spinat",
            "stikkelsbaer",
            "timian",
            "tinca",
            "ungarsk-lang",
            null
          ]
        },
        "antal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Antal planter i zonen (valgfrit)"
        },
        "afgrøder": {
          "type": "array",
          "description": "Sædskifte: to eller flere afgrøder med perioder (fra/til måneder)",
          "items": {
            "$ref": "#/$defs/Afgrøde"
          }
        }
      }
    },
    "Afgrøde": {
      "type": "object",
      "required": [
        "plante_id",
        "fra",
        "til"
      ],
      "additionalProperties": false,
      "properties": {
        "plante_id": {
          "type": "string",
          "description": "Reference til plante i planter.yaml",
          "enum": [
            "allium-sativum",
            "brombaer",
            "busktomat",
            "california-wonder",
            "cayenne",
            "citronmelisse",
            "diamant",
            "dild",
            "estragon",
            "filippa",
            "genovese",
            "goldball",
            "groen-tapas",
            "groene-aerter",
            "gulloeg",
            "habenero",
            "half-tall",
            "hindbaer",
            "ingrid-marie",
            "jordbaer",
            "koervel",
            "koriander",
            "marketmore",
            "matador",
            "maxi",
            "money-maker",
            "mynte",
            "nantes",
            "nero-di-toscana",
            "ola-escalladora",
            "oregano",
            "paere",
            "pak-choi",
            "persille",
            "pluksalat",
            "purloeg",
            "quadro",
            "rabarber",
            "radise",
            "ribs",
            "roedloeg",
            "rosmarin",
            "rucola",
            "salat",
            "salvie",
            "sava",
            "scarlet",
            "snitloeg",
            "solbaer",
            "solist",
            "solstik",
            "sommersar",
            "spinat",
            "stikkelsbaer",
            "timian",
            "tinca",
            "ungarsk-lang",
            null
          ]
        },
        "fra": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "Første måned i jorden (1=jan … 12=dec)"
        },
        "til": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "Sidste måned i jorden (1=jan … 12=dec)"
        },
        "antal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Antal planter (valgfrit)"
        }
      }
    }
  }
}
