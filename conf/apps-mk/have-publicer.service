[Unit]
Description=Publicer have-indlaeg fra inbox
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=apps
Group=apps
Environment=HAVE_DIR=/mnt/sheevahome/Drive/synosync/3.Resources/have.py
Environment=HAVE_VENV=/srv/apps/have-venv
Environment=INBOX_DIR=/srv/apps/have_inbox-data/inbox
EnvironmentFile=/etc/have/deploy.env
ExecStart=/srv/apps/bin/have-publicer.sh
# Type=oneshot har som standard INGEN start-timeout. En haengende koersel
# (lftp der blev ved med at proeve et afvist sftp-login, 5.-12. sep 2026)
# stod derfor i "activating" i seks dage,
# og saa laenge kan timeren aldrig starte en ny. En normal koersel tager
# 12-20 sekunder; 30 min er rigeligt selv til en fuld upload.
TimeoutStartSec=30min
