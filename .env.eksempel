# .env.eksempel
# Kopiér denne fil til .env og udfyld med dine egne adgangskoder.
# .env må ALDRIG committes — den er gitignored.

# SFTP kræver INGEN adgangskode her: deploy over sftp går gennem ssh med
# nøgle (ssh-agenten), og lftp kan ikke aflevere et kodeord til ssh.
# Adgang gives med ssh-copy-id, ikke i denne fil.

# FTP-adgangskode til deploy (hvis brugt)
HAVE_FTP_KODE=
